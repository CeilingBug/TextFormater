<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Toggle Background</title>
  <style>
    body {
      background-color: white;
      color: black;
      transition: background-color 0.3s, color 0.3s; /* smooth effect */
    }
    .dark-mode {
      background-color: black;
      color: white;
    }
    button {
      margin: 20px;
      padding: 10px 20px;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <button onclick="toggleBackground()">Toggle Background</button>

  <h1>Hello World!</h1>
  <p>This text will switch between light and dark mode.</p>

  <script>
    function toggleBackground() {
      document.body.classList.toggle("dark-mode");
    }
  </script>
</body>
</html>
